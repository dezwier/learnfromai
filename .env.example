ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://mastery:mastery@localhost:5433/adaptive_mastery
SECRET_KEY=replace-with-at-least-32-characters
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_AUTH_EMULATOR_HOST=
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TEMPERATURE=0.0
CORS_ORIGINS=http://localhost:8080
SENTRY_DSN=
LLM_DAILY_TOKENS_USER_LIMIT=1000000
LLM_DAILY_SPEND_EUR_LIMIT=3
LLM_USD_PER_EUR=1.0
GRAPH_EXPANSION_MAX_NODES=80
JOB_WORKER_CONCURRENCY=2
# Server default when the user has no preference: openai | gemini | fake
LLM_PROVIDER=openai
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Affinity (profile map + base score for cron) ---
# Per-user normalized factors (focus+open only), then weighted sum (weights=1):
# interest_norm = (focus+open) / total focus+open across tiles
# neighbor_norm = Σ_neighbors (focus+open) / same total
# recency = linear last focus/open: today→1, ≥span days→0.5
# affinity = w_interest*interest_norm + w_neighbor*neighbor_norm + w_recency*recency
AFFINITY_W_INTEREST=1.0
AFFINITY_W_NEIGHBOR=1.0
AFFINITY_W_RECENCY=1.0
AFFINITY_RECENCY_SPAN_DAYS=30.0

# --- Cron: expand-neighborhood jobs ---
# score = aggregated_affinity + w_fill * (desired_neighbors - n) / desired_neighbors
CRON_NEIGHBOR_W_FILL=1.0
CRON_NEIGHBOR_BUDGET_TOTAL=16
CRON_NEIGHBOR_JOBS_PER_DAY=5

# --- Cron: expand-content (atomic pack) jobs ---
# score = aggregated_affinity + w_fill * (desired_packs - packs) / desired_packs
CRON_LEARN_W_FILL=1.0
CRON_LEARN_DESIRED_PACKS=20
CRON_LEARN_JOBS_PER_DAY=10

# --- Learning track (in-app next card) ---
LEARN_TRACK_EXPLOIT_P=0.7
