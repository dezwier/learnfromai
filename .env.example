ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://mastery:mastery@localhost:5433/adaptive_mastery
SECRET_KEY=replace-with-at-least-32-characters
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_AUTH_EMULATOR_HOST=
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TEMPERATURE=0.0
CORS_ORIGINS=http://localhost:8080
SENTRY_DSN=
LLM_DAILY_TOKENS_USER_LIMIT=1000000
LLM_DAILY_SPEND_EUR_LIMIT=3
LLM_USD_PER_EUR=1.0
GRAPH_EXPANSION_MAX_NODES=80
JOB_WORKER_CONCURRENCY=2
# Server default when the user has no preference: gemini | openai | fake
LLM_PROVIDER=gemini
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Ranking / daily cron (weights only; soft recency decay — no hard caps)
# affinity(u,t)=(w_focus*focus+w_open*open+w_learned*learned+w_packs*packs_done
#   +w_new*recency(node_age))*recency(last_event)
# neighbor_score=tile_affinity/(1+w_neighbor_penalty*neighbors)
# learn_score=tile_affinity/(1+w_pack_penalty*packs)
RANK_W_FOCUS=1.0
RANK_W_OPEN=2.0
RANK_W_LEARNED=3.0
RANK_W_PACKS=1.0
RANK_W_NEW=2.0
RANK_HALF_LIFE_DAYS=14.0
RANK_W_NEIGHBOR_PENALTY=1.0
RANK_W_PACK_PENALTY=2.0
CRON_NEIGHBOR_JOBS_PER_DAY=5
CRON_LEARN_JOBS_PER_DAY=10
CRON_NEIGHBOR_BUDGET_TOTAL=16
